<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Папка для логов: рядом с JAR -->
    <property name="LOG_DIR" value="${application.home}/logs"/>
    <property name="LOG_FILE" value="${LOG_DIR}/app.log"/>

    <!-- Консоль (для удобства при локальном запуске) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Файл: текущий лог в app.log (текст), ротация по дню и размеру -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- logback сам создаст папку при необходимости -->
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Роллим раз в день и по размеру; старые — в gzip -->
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <totalSizeCap>2GB</totalSizeCap>
            <maxHistory>14</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <append>true</append>
    </appender>

    <!-- Уровни логов: корень на INFO; можно детальнее для твоих пакетов -->
    <logger name="com.suhoi.mexcwebsocket" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
